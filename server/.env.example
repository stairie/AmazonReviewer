OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ASSISTANT=your_assistant_id_here
OPENAI_RESPONSES_MODEL=gpt-4.1-mini
OPENAI_REVIEW_INSTRUCTIONS_FILE=review-instructions.txt
FETCH_REVIEW_CONTEXT=true
REVIEW_FETCH_TIMEOUT_MS=6000
REVIEW_CONTEXT_CHAR_LIMIT=5000
# Optional fallback if no file is present:
# OPENAI_REVIEW_INSTRUCTIONS=You are an expert Amazon product review analyst. Provide clear sections: Summary, Rating Analysis, Improvement Suggestions, Key Insights.
